// Proposed syntax only; the scaffold does not parse this file.
schema 1
dock {
    outputs "all"
    edge "bottom"
    align "center"
    tile-size 48
    spacing 6
    pin "terminal" label="Terminal" icon="terminal"
    pin "browser" label="Browser" icon="browser"
    pin "files" label="Files" icon="files"
}
