// Accepted configuration syntax; catalog resolution and native serving remain pending.
schema 1
dock {
    outputs "all"
    edge "bottom"
    align "center"
    tile-size 48
    spacing 6
    pin "registered:terminal" label="Terminal" icon="terminal"
    pin "registered:browser" label="Browser" icon="browser"
    pin "registered:files" label="Files" icon="files"
}
// Pins must resolve through the authorized catalog; these IDs are illustrative.
